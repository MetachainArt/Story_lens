# Copy this file to deploy/.env.production on the server.
# Never commit deploy/.env.production or paste real secrets into this example.

# Database
DATABASE_URL=postgresql+asyncpg://storylens:CHANGE_ME@db:5432/story_lens
DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Authentication
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production
ALLOW_TEACHER_REGISTRATION=false
TEMPLATE_MANAGER_EMAIL=park.js
# Optional one-time bootstrap values. Do not leave a real password in Git.
INITIAL_TEACHER_EMAIL=
INITIAL_TEACHER_NAME=
INITIAL_TEACHER_PASSWORD=
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_IP_MAX_ATTEMPTS=100
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REFRESH_MAX_ATTEMPTS=30
AUTH_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_RETENTION_DAYS=7
STT_MAX_REQUESTS_PER_MINUTE=20
PRIVACY_POLICY_VERSION=2026-07-10
PHOTO_RETENTION_DAYS=365
PHOTO_RETENTION_SWEEP_SECONDS=21600
MAX_IMAGE_UPLOAD_BYTES=31457280
MAX_IMAGE_PIXELS=40000000

# Browser origins
ALLOWED_ORIGINS=https://storylens.example.com
PUBLIC_API_URL=https://api.storylens.example.com

# AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
KIE_API_KEY=
OPENAI_API_KEY=
IMAGE_PROVIDER=kie
IMAGE_DEFAULT_MODEL=gpt-image-2
KIE_SUNO_MODEL=V4_5ALL
