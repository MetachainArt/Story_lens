# Supabase / managed Postgres
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:6543/postgres?sslmode=require

# Tests must use a dedicated test project/database (never same as DATABASE_URL)
TEST_DATABASE_URL=postgresql+asyncpg://<test-user>:<test-password>@<test-host>:6543/postgres?sslmode=require
SECRET_KEY=changeme
ENVIRONMENT=development
