# Supabase / managed Postgres
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:6543/postgres?sslmode=require

# Tests must use a dedicated test project/database (never same as DATABASE_URL)
TEST_DATABASE_URL=postgresql+asyncpg://<test-user>:<test-password>@<test-host>:6543/postgres?sslmode=require
SECRET_KEY=changeme
ENVIRONMENT=development

# Security / access control
# Public self-registration as a teacher (POST /api/auth/register). Keep false in
# production; teachers should be provisioned by an admin / seed script.
ALLOW_TEACHER_REGISTRATION=false
# Email of the single account allowed to manage prompt templates. Leave empty to
# deny template management to everyone.
TEMPLATE_MANAGER_EMAIL=park.js

# Shared database-backed limits (requires Alembic revision 011)
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_IP_MAX_ATTEMPTS=100
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REFRESH_MAX_ATTEMPTS=30
AUTH_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_RETENTION_DAYS=7
STT_MAX_REQUESTS_PER_MINUTE=20
PRIVACY_POLICY_VERSION=2026-07-10
PHOTO_RETENTION_DAYS=365
PHOTO_RETENTION_SWEEP_SECONDS=21600
MAX_IMAGE_UPLOAD_BYTES=31457280
MAX_IMAGE_PIXELS=40000000
