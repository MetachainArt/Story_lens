# Supabase / managed Postgres
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:6543/postgres?sslmode=require

# Tests must use a dedicated test project/database (never same as DATABASE_URL)
TEST_DATABASE_URL=postgresql+asyncpg://<test-user>:<test-password>@<test-host>:6543/postgres?sslmode=require

# Auth
SECRET_KEY=story-lens-dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
# Development default. In production, set this to the Oracle/OCI-hosted public backend origin.
# Current server IP: 158.180.75.224
# Production API origin: https://api.storylens.dmssolution.co.kr
VITE_API_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# AI image generation
IMAGE_PROVIDER=kie
IMAGE_DEFAULT_MODEL=gpt-image-2
IMAGE_GENERATION_DAILY_LIMIT=20
IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_COOLDOWN_SECONDS=30
IMAGE_PROVIDER_ALLOWLIST=kie,openai
IMAGE_MODEL_ALLOWLIST=gpt-image-2,gpt-image-2-image-to-image
KIE_API_KEY=
OPENAI_API_KEY=
